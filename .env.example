# ==================== DeepSeek API 配置（必填） ====================
# 在 https://platform.deepseek.com/api_keys 创建并复制你的 API Key，粘贴到下方等号后面
DEEPSEEK_API_KEY=sk-你的DeepSeek-API-Key

# DeepSeek 接口地址（默认官方地址，一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称（默认 deepseek-chat，即 DeepSeek-V3）
DEEPSEEK_MODEL=deepseek-chat

# ==================== 可选调优参数（可不填，使用默认值） ====================
# 单个切片目标长度（字符数），建议 500-1000
CHUNK_SIZE=800

# 相邻切片重叠长度（字符数），建议 100-200
CHUNK_OVERLAP=150

# 每次检索返回的片段数量，建议 3-5
TOP_K=5

# 相关性阈值：余弦相似度低于该值的片段视为不相关（0-1 之间）
RELEVANCE_THRESHOLD=0.25

# Embedding 模型（默认轻量英文模型；中文文档多可改为 BAAI/bge-small-zh-v1.5）
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# HuggingFace 模型下载镜像地址（默认已配置国内镜像 hf-mirror.com，一般无需修改；
# 若网络环境可直连 huggingface.co，可改为 https://huggingface.co）
HF_ENDPOINT=https://hf-mirror.com
