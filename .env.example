# ==================== DeepSeek API 配置（必填） ====================
# 在 https://platform.deepseek.com/api_keys 创建并复制你的 API Key，粘贴到下方等号后面
DEEPSEEK_API_KEY=sk-你的DeepSeek-API-Key

# DeepSeek 接口地址（默认官方地址，一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称（默认 deepseek-chat，即 DeepSeek-V3）
DEEPSEEK_MODEL=deepseek-chat

# ==================== 可选调优参数（可不填，使用默认值） ====================
# 生成温度：0.1=极保守(幻觉低)；0.3=轻度放宽(允许合理归纳，幻觉可控)；
# 0.5=平衡；0.7=较强发散
DEEPSEEK_TEMPERATURE=0.3

# 单个切片目标长度（字符数）。bge-small-zh-v1.5 的 token 窗口为 512，
# 切片控制在 500 字符内可保证完整向量化、避免尾部截断。
CHUNK_SIZE=500

# 相邻切片重叠长度（字符数），保证跨块边界信息不丢
CHUNK_OVERLAP=100

# 每次检索返回的片段数量。8 扩大候选池，提高召回上限
TOP_K=8

# 相关性阈值：余弦相似度低于该值的片段视为不相关（0-1 之间）。
# bge-small-zh 相似度分布整体偏低，阈值降至 0.15 避免正确片段被误过滤
RELEVANCE_THRESHOLD=0.15

# Embedding 模型。默认中文模型 bge-small-zh-v1.5，召回效果优于英文模型。
# 如需切回轻量英文模型可改为 sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# HuggingFace 模型下载镜像地址（默认已配置国内镜像 hf-mirror.com，一般无需修改；
# 若网络环境可直连 huggingface.co，可改为 https://huggingface.co）
HF_ENDPOINT=https://hf-mirror.com

# ==================== OCR 降级配置（扫描件 PDF，可选） ====================
# 当 pdfplumber 提取不到文本层（疑似扫描件）时，降级用 Tesseract OCR 识别。
# 前置：系统需安装 Tesseract OCR 引擎并加入 PATH，pip 已声明 pytesseract 依赖。
# 未安装时自动跳过，不影响纯文本 PDF 解析。
# 设为 false 可彻底关闭 OCR 降级
OCR_ENABLED=true
# OCR 识别语言包：chi_sim+eng 同时识别中英文；仅英文设为 eng
OCR_LANG=chi_sim+eng
# 转图分辨率（DPI）：越高越清晰但越慢，300 适合常规扫描件
OCR_DPI=300
